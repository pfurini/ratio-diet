// Ultracite oxfmt Configuration
// https://oxc.rs/docs/guide/usage/formatter/config-file-reference.html
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Ignore all hidden directories, all jsonc files, and all root files
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".augment/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".devcontainer/**",
    ".goose/**",
    ".husky/**",
    ".kilocode/**",
    ".kiro/**",
    ".pnpm-store/**",
    ".superpowers/**",
    ".turbo/**",
    ".vscode/**",
    ".zencoder/**",
    ".*/**",
    "**/.*/**",
    "**/_generated/**",
    "**/*.js",
    "**/*.jsonc",
    "**/*.d.ts",
    ".coderabbit.yaml",
    ".gitignore",
    ".mcp.json",
    ".oxlintrc.json",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "apps/web/src/components/**/*.ts",
    "apps/web/src/components/**/*.tsx",
    "apps/web/src/components/**/*.js",
    "apps/web/src/components/**/*.jsx",
    "apps/web/src/components/**/*.css",
    "packages/ui/src/components/**",
    "skills-lock.json",
    "tsconfig.*.json",
    "tsconfig.json",
    "turbo.json",
    "components.json",
  ],
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "never",
  "sortPackageJson": false
}
