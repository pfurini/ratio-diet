{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "better-auth": {
      "url": "https://mcp.inkeep.com/better-auth/mcp"
    },
    "augment-context-engine": {
      "type": "local",
      "command": "auggie",
      "args": ["--mcp", "--mcp-auto-workspace"],
      "enabled": true
    }
  }
}
