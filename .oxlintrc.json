{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["vitest"],
  "extends": [
    "./node_modules/ultracite/config/oxlint/core/.oxlintrc.json",
    "./node_modules/ultracite/config/oxlint/next/.oxlintrc.json"
  ],
  "rules": {
    "unicorn/filename-case": "off",
    "vitest/prefer-called-times": "off",
    "vitest/require-hook": "off",
    "max-statements": ["error", { "max": 20 }]
  },
  "ignorePatterns": [
    ".*/**",
    "**/.*/**",
    "**/_generated/**",
    "**/*.js",
    "**/*.jsonc",
    "**/*.d.ts",
    ".coderabbit.yaml",
    ".gitignore",
    ".mcp.json",
    ".oxlintrc.json",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "apps/web/src/components/**/*.ts",
    "apps/web/src/components/**/*.tsx",
    "apps/web/src/components/**/*.js",
    "apps/web/src/components/**/*.jsx",
    "apps/web/src/components/**/*.css",
    "packages/ui/src/components/**",
    "skills-lock.json",
    "tsconfig.*.json",
    "tsconfig.json",
    "turbo.json",
    "components.json"
  ]
}
