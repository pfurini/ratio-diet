# Set Google AI API key for AI agent
# npx convex env set GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key

# Set Convex environment variables
# npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
# npx convex env set SITE_URL http://localhost:3001
# Google AI API key for AI agent
# GOOGLE_GENERATIVE_AI_API_KEY=
# Same as CONVEX_URL but ends in .site
# NEXT_PUBLIC_CONVEX_SITE_URL=
# Web app URL for authentication
SITE_URL=http://localhost:3001

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:fastidious-coyote-142 # team: datagenia, project: ratio-diet

CONVEX_URL=https://fastidious-coyote-142.convex.cloud

CONVEX_SITE_URL=https://fastidious-coyote-142.convex.site
